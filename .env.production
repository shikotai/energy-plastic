# Production settings, read by `npm run build` (Vite + scripts/postbuild.mjs).
# These values are public by nature (they end up in the HTML), so this file is committed.

# Public URL of the site, without a trailing slash.
VITE_SITE_URL=https://energy-plastic.kz

# Analytics counters. Leave empty until they are created.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_ID=
# Yandex Metrika counter number, e.g. 12345678
VITE_YANDEX_METRIKA_ID=

# Webmaster panel ownership verification (only the `content` value of the meta tag).
# Google Search Console -> "HTML tag" method
VITE_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster -> "Meta tag" method
VITE_YANDEX_VERIFICATION=
